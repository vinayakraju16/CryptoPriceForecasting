# Copy this file to .env and fill in your own values. Never commit .env.

# Reddit API (https://www.reddit.com/prefs/apps) - used only by
# scripts/fetch_reddit_sentiment.py
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=crypto-forecast/2.0

# Web app
HOST=127.0.0.1
PORT=8501
FLASK_DEBUG=0

# Optional: override where the coin_*.csv files are read from
# CRYPTO_CSV_DIR=./CSV
